APP_NAME="Household"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=finance
DB_USERNAME=finance_app
DB_PASSWORD=local-app-password
DB_ADMIN_PASSWORD=local-admin-password
