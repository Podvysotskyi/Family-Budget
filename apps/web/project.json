{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web/app",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/web",
        "command": "nuxt dev --host 127.0.0.1"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/web",
        "command": "nuxt build"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/web",
        "command": "nuxt preview"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/web",
        "command": "nuxt typecheck"
      }
    },
    "prepare": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/web",
        "command": "nuxt prepare"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/web",
        "command": "../../node_modules/.bin/vitest run"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/web",
        "command": "../../node_modules/.bin/vitest run --project web-unit"
      }
    },
    "test:feature": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/web",
        "command": "../../node_modules/.bin/vitest run --project web-feature"
      }
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/web",
        "command": "../../node_modules/.bin/vitest run --project web-e2e"
      }
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/web",
        "command": "../../node_modules/.bin/vitest run --coverage"
      }
    }
  }
}
