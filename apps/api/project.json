{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nest start --watch --config apps/api/nest-cli.json"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nest build --config apps/api/nest-cli.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/api/tsconfig.app.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "../../node_modules/.bin/vitest run"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "../../node_modules/.bin/vitest run --project api-unit"
      }
    },
    "test:feature": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "../../node_modules/.bin/vitest run --project api-feature"
      }
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "../../node_modules/.bin/vitest run --coverage"
      }
    }
  }
}
